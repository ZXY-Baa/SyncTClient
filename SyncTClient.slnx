<Solution>
  <Folder Name="/src/">
    <!-- Startbare Projekte zuerst: Visual Studio nimmt sonst das erste
         Projekt als Startprojekt, und eine Klassenbibliothek laesst sich
         nicht starten. -->
    <Project Path="src/SyncTClient.Mount/SyncTClient.Mount.csproj" />
    <Project Path="src/SyncTClient.Gui/SyncTClient.Gui.csproj" />
    <Project Path="src/SyncTClient.Probe/SyncTClient.Probe.csproj" />
    <Project Path="src/SyncTClient.Bep/SyncTClient.Bep.csproj" />
    <Project Path="src/SyncTClient.ThumbHost/SyncTClient.ThumbHost.csproj">
      <Platform Project="x64" />
    </Project>
    <Project Path="src/SyncTClient.ExplorerProvider/SyncTClient.ExplorerProvider.csproj">
      <Platform Project="x64" />
    </Project>
    <Project Path="src/SyncTClient.Vfs/SyncTClient.Vfs.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <!-- Nur die Rechnung, nicht die Laufzeit: was einen Sync-Root, eine
         Verbindung oder eine Datenbank braucht, steht hier nicht. -->
    <Project Path="src/SyncTClient.Tests/SyncTClient.Tests.csproj" />
  </Folder>
</Solution>
